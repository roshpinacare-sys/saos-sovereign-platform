// SAOS Sovereign Foundry v2 — data model
// The platform state: sovereign chain seals, public anchors, energy plans,
// economy simulations, evidence receipts and the research verdict ledger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Sovereign chain: sealing roots (שורשי-האיטום) ────────────────────────────

model SealRecord {
  id          String       @id @default(cuid())
  height      Int          @unique // chain height at seal time
  root        String       @unique // merkle root of the batch (hex)
  leavesCount Int
  stateRoot   String // sha256 of canonical kernel state
  gasUsed     Int
  note        String?
  createdAt   DateTime     @default(now())
  anchors     AnchorTx[]
  leaves      SealLeaf[]
  receipts    EvidenceReceipt[]

  @@index([createdAt])
}

model SealLeaf {
  id      String     @id @default(cuid())
  sealId  String
  seal    SealRecord @relation(fields: [sealId], references: [id], onDelete: Cascade)
  index   Int
  kind    String // stamp | seal | harvest | relay | wallet
  payload String // canonical JSON of the leaf
  digest  String // sha256 of canonical payload

  @@unique([sealId, index])
  @@index([digest])
}

// ─── Public anchoring (העגינה הציבורית) ──────────────────────────────────────

model AnchorTx {
  id        String      @id @default(cuid())
  sealId    String?
  seal      SealRecord? @relation(fields: [sealId], references: [id])
  network   String // STEEM | BLURT | HIVE | TRON
  kind      String // weave | checkpoint | identity
  txid      String? // null while pending/gated — honest, never fabricated
  status    String // anchored | pending | gated | transit
  gate      String? // why not anchored yet (rc-floor, cooldown, energy-0 ...)
  meta      String? // JSON extras (rc %, energy, cooldown minutes...)
  createdAt DateTime    @default(now())

  @@index([network, status])
  @@index([sealId])
}

// ─── Energy sovereignty (ריבונות אנרגיה) ─────────────────────────────────────

model EnergyPlan {
  id          String   @id @default(cuid())
  network     String // TRON | HIVE
  mode        String // energize | powerup | delegate
  trxStaked   Int? // sun
  energyOut   Int? // estimated daily energy
  settlements Int? // USDT settlements per day (~65k energy each)
  burnCost    Int? // sun/day if no staking
  rcFloorPct  Float? // hive floors
  notes       String?
  payload     String // full canonical plan JSON
  createdAt   DateTime @default(now())
}

// ─── Economy (המשק — harvest & grid) ────────────────────────────────────────

model EconomySnapshot {
  id          String   @id @default(cuid())
  label       String
  inputs      String // canonical JSON inputs
  streams     String // JSON per-stream output
  totalPerDay Float
  flywheelPct Float
  createdAt   DateTime @default(now())
}

// ─── Evidence (ראיות — hash-chained receipts) ────────────────────────────────

model EvidenceReceipt {
  id         String      @id @default(cuid())
  kind       String // seal | selftest | verify-pack | energy-plan | economy-sim
  digest     String      @unique
  prevDigest String?
  payload    String
  at         String? // the EXACT timestamp inside the digest (Receipt.at) — nullable for legacy rows; recovered via digest brute-force
  seal       SealRecord? @relation(fields: [sealId], references: [id])
  sealId     String?
  createdAt  DateTime    @default(now())

  @@index([kind])
}

// ─── Research verdict ledger (פסק-הדין של המחקר) ─────────────────────────────

model ResearchFinding {
  id       String @id @default(cuid())
  archive  String @unique
  rank     Int
  score    Int // 0..100 trailblazer score
  verdict  String
  salvage  String // JSON top salvage items
  evidence String // JSON validation evidence
}

// ─── Ops audit (יומן תפעול) ─────────────────────────────────────────────────

model OpLog {
  id        String   @id @default(cuid())
  op        String
  detail    String?
  createdAt DateTime @default(now())

  @@index([op])
}

// ─── v5: Vault registry (רישום כספת — כתובות ציבוריות בלבד) ────────────────
// Public watch addresses per network/slot. NEVER holds signing keys —
// keys live in the offline AES vault (stage 2). Honest by construction.

model VaultSlot {
  id          String   @id @default(cuid())
  network     String // STEEM | BLURT | HIVE | TRON
  slot        String // foundry/active | foundry/manual-sign | vault-1..6
  address     String? // public watch address — not a secret, not a key
  fingerprint String? // sha256(canonical({network, slot, address})) — registration integrity
  keyState    String   @default("missing") // missing = key in offline vault
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([network, slot])
  @@index([network])
}

// ─── v9: Platform settings (הגדרות-פלטפורמה) ──────────────────────────────
// Key/value runtime settings (auto-anchor toggle). Never holds secrets —
// control-plane state only. Additive, honest, togglable from the console.

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── v13: SAOS sovereign mint (טביעת המטבע הריבוני) ────────────────────────
// The small SAOS mint: one batch = one seal on SAOS-NET whose leaves are
// kernel ops (harvest = mint into treasury, wallet = allocate to soldier),
// merkle-rooted and anchored on the live rails. The entries are the
// persistent sovereign ledger — who holds how much SAOS.

model SaosMint {
  id              String   @id @default(cuid())
  mintId          String   @unique // canonical: mint-<sealHeight>
  total           Int // total SAOS minted in this batch
  soldiers        Int // # soldiers allocated
  perSoldier      Int
  treasuryReserve Int // dev reserve kept for development
  payload         String // canonical allocation JSON
  digest          String // sha256(canonical payload)
  sealHeight      Int?
  sealRoot        String?
  status          String // allocated | sealed | anchored
  createdAt       DateTime @default(now())
  entries         SaosMintEntry[]

  @@index([createdAt])
}

model SaosMintEntry {
  id     String   @id @default(cuid())
  mintId String
  mint   SaosMint @relation(fields: [mintId], references: [id], onDelete: Cascade)
  agent  String // soldier username | saos:dev-reserve
  role   String // soldier | treasury
  amount Int

  @@unique([mintId, agent])
  @@index([agent])
}

// ─── v14: Sovereign relay contract (החוזה הריבוני — saos-relay/v1) ────────
// The fee-free on-chain link: one row per chain (ETHEREUM · BSC — same
// bytecode, same sovereign EOA). Holds the deployed address, deployment
// proof (txid, block, gas, cost, runtime bytecode hash) and status.
// The contract itself is immutable on-chain — this row is our honest book.

model SovereignContract {
  id           String   @id @default(cuid())
  chain        String   @unique // ethereum | bsc
  kind         String   @default("saos-relay/v1")
  address      String
  deployer     String?
  txid         String?
  blockNumber  Int?
  gasUsed      Int?
  costNative   String? // ETH / BNB
  bytecodeHash String? // sha256(runtime code) — measured on-chain
  runtimeBytes Int?
  status       String // deployed | failed | gated
  meta         String? // JSON extras (compiler, explorer, event args...)
  createdAt    DateTime @default(now())

  @@index([status])
}

// ─── v18: Real work deliverables (מסירות עבודה אמיתיות) ─────────────────────
// When a work order is delivered with REAL WORK, the platform's solution
// engine (server-side LLM) generates an actual deliverable for the mission:
// a concrete plan — summary, steps, risks, value note. The full content
// lives here; its sha256 digest is anchored on-chain (SAOSBridge "SAOS-WORK"
// rail → stamped into every subsequent mesh run) and notarized into the
// hash-chained evidence receipts. Content is real generated text — never
// fabricated; SAOS-M remains internal-lab value.

model WorkDeliverable {
  id            String   @id @default(cuid())
  orderId       Int      @unique
  runId         Int?
  soldier       String? // the delivering soldier (public address)
  mission       String
  title         String
  summary       String
  steps         String // JSON string[] — concrete execution steps
  risks         String // JSON string[] — honest risks
  valueNote     String // one-line value statement
  digest        String   @unique // sha256 of the canonical deliverable JSON
  anchorTx      String? // on-chain anchorExternal txid (SAOS-WORK rail)
  anchorBlock   Int?
  receiptDigest String? // hash-chained evidence receipt digest
  engine        String   @default("z-ai-llm") // the generation engine id
  latencyMs     Int      @default(0)
  chars         Int      @default(0)
  tokensEst     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ─── v13: Fleet arming ledger (יומן חימוש הצי) ─────────────────────────────
// Every whitelisted disbursement to a soldier leaves an honest row:
// rail (STEEM-RC | STEEM-TR | EVM | SOL), agent, amount, txid, status.
// Failed/gated attempts are recorded with the same discipline.

model FleetArmOp {
  id        String   @id @default(cuid())
  rail      String // STEEM-RC | STEEM-TR | EVM | SOL
  agent     String
  amount    String // canonical per-rail units ("1000000.000000 VESTS" | "0.0002 ETH" | "0.006 SOL" | "0.050 STEEM")
  txid      String? // from the node — never fabricated
  explorer  String?
  detail    String // JSON extras (block/slot, confirmed, reserve-after...)
  status    String // armed | failed | gated
  createdAt DateTime @default(now())

  @@index([rail, status])
  @@index([agent])
}
