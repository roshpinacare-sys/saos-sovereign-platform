// SAOS Sovereign Foundry v2 — data model
// The platform state: sovereign chain seals, public anchors, energy plans,
// economy simulations, evidence receipts and the research verdict ledger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Sovereign chain: sealing roots (שורשי-האיטום) ────────────────────────────

model SealRecord {
  id          String       @id @default(cuid())
  // FIX(73): height אינו ייחודי — 1,191 חותמות-מורשת (2026-09-07) נרשמו עם height=0
  // והקוד קורא tip דרך orderBy(height desc) בלבד. הייחודיות-האמתית = root (מרקל) @unique.
  // היה-כאן @unique שה-DB מעולם-לא-קיבל — כל-db:push נכשל (UNIQUE failed) וחסם-מיגרציות.
  height      Int          @default(0) // chain height at seal time
  root        String       @unique // merkle root of the batch (hex)
  leavesCount Int
  stateRoot   String // sha256 of canonical kernel state
  gasUsed     Int          @default(0)
  note        String?
  createdAt   DateTime     @default(now())
  anchors     AnchorTx[]
  leaves      SealLeaf[]
  receipts    EvidenceReceipt[]

  @@index([createdAt])
  @@index([height])
}

model SealLeaf {
  id      String     @id @default(cuid())
  sealId  String
  seal    SealRecord @relation(fields: [sealId], references: [id], onDelete: Cascade)
  index   Int
  kind    String // stamp | seal | harvest | relay | wallet
  payload String // canonical JSON of the leaf
  digest  String // sha256 of canonical payload

  @@unique([sealId, index])
  @@index([digest])
}

// ─── Public anchoring (העגינה הציבורית) ──────────────────────────────────────

model AnchorTx {
  id        String      @id @default(cuid())
  sealId    String?
  seal      SealRecord? @relation(fields: [sealId], references: [id])
  network   String // STEEM | BLURT | HIVE | TRON
  kind      String // weave | checkpoint | identity
  txid      String? // null while pending/gated — honest, never fabricated
  status    String // anchored | pending | gated | transit
  gate      String? // why not anchored yet (rc-floor, cooldown, energy-0 ...)
  meta      String? // JSON extras (rc %, energy, cooldown minutes...)
  createdAt DateTime    @default(now())

  @@index([network, status])
  @@index([sealId])
}

// ─── Energy sovereignty (ריבונות אנרגיה) ─────────────────────────────────────

model EnergyPlan {
  id          String   @id @default(cuid())
  network     String // TRON | HIVE
  mode        String // energize | powerup | delegate
  trxStaked   Int? // sun
  energyOut   Int? // estimated daily energy
  settlements Int? // USDT settlements per day (~65k energy each)
  burnCost    Int? // sun/day if no staking
  rcFloorPct  Float? // hive floors
  notes       String?
  payload     String // full canonical plan JSON
  createdAt   DateTime @default(now())
}

// ─── Economy (המשק — harvest & grid) ────────────────────────────────────────

model EconomySnapshot {
  id          String   @id @default(cuid())
  label       String
  inputs      String // canonical JSON inputs
  streams     String // JSON per-stream output
  totalPerDay Float
  flywheelPct Float
  createdAt   DateTime @default(now())
}

// ─── Evidence (ראיות — hash-chained receipts) ────────────────────────────────

model EvidenceReceipt {
  id         String      @id @default(cuid())
  kind       String // seal | selftest | verify-pack | energy-plan | economy-sim
  digest     String      @unique
  prevDigest String?
  payload    String
  seal       SealRecord? @relation(fields: [sealId], references: [id])
  sealId     String?
  createdAt  DateTime    @default(now())

  @@index([kind])
  // FIX(Roast-65-b · M10): verify-pack טוען-הכל-ממוין לפי-createdAt בכל-איטום
  // ו-seal קורא-tip — סריקה-מלאה-ומיון-בכל-פעם בלי-אינדקס.
  @@index([createdAt])
}

// ─── Research verdict ledger (פסק-הדין של המחקר) ─────────────────────────────

model ResearchFinding {
  id       String @id @default(cuid())
  archive  String @unique
  rank     Int
  score    Int // 0..100 trailblazer score
  verdict  String
  salvage  String // JSON top salvage items
  evidence String // JSON validation evidence
}

// ─── Ops audit (יומן תפעול) ─────────────────────────────────────────────────

model OpLog {
  id        String   @id @default(cuid())
  op        String
  detail    String?
  createdAt DateTime @default(now())

  @@index([op])
}

// ─── Sovereign Key Vault (כספת-המפתחות — חומר רק מוצפן) ─────────────────────

model VaultKey {
  id             String    @id @default(cuid())
  account        String // headcorner / cashmachine / wallet:headcorner-evm ...
  chain          String // steem | hive | evm | tron | sol | btc | seed | mnemonic
  role           String // owner | active | posting | memo | wallet | seed | mnemonic
  pubKey         String? // STM... for steem/hive
  address        String? // wallet address
  cipher         String // AES-256-GCM "iv:tag:ct" hex — plaintext NEVER stored
  fingerprint    String // sha256(plaintext)[:16] — id without exposure
  verified       Boolean   @default(false)
  lastVerifiedAt DateTime?
  lastError      String?
  source         String    @default("import")
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([account, chain, role])
  @@index([account])
}

// ─── Sessions (התחברות — נשאר מחובר) ─────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 of the cookie token
  label     String   @default("operator")
  scope     String   @default("owner") // owner | agent
  keyRef    String? // which vault key opened it
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)
}

// ─── Agent mesh (סוכנים חיצוניים דרך API) ────────────────────────────────────

model AgentNode {
  id           String    @id @default(cuid())
  name         String    @unique
  tokenHash    String    @unique
  capabilities String    @default("") // csv: chat,task,execute-post
  status       String    @default("active") // active | suspended | revoked
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
}

// ─── Shared chat (צ'אט משותף בעלים⇄סוכנים) ───────────────────────────────────

model ChatMessage {
  id        String   @id @default(cuid())
  author    String // "owner" | agent name | "system"
  role      String // owner | agent | system
  content   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Tasks (משימות לסוכנים) ──────────────────────────────────────────────────

model TaskItem {
  id         String   @id @default(cuid())
  title      String
  detail     String   @default("")
  createdBy  String // owner | agent name
  assignedTo String   @default("") // agent name or "" = open
  status     String   @default("open") // open | claimed | done | failed
  result     String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

// ─── Audit + Guard (שלא יקרה שוב) ────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model GuardState {
  id        String   @id @default("singleton")
  ownerLock Boolean  @default(true) // ON = no owner-authority mutations ever without explicit operator unlock
  note      String   @default("")
  updatedAt DateTime @updatedAt
}

// ─── Liquidity Hub (מרכז-הנזילות · 73) — מנועי-משיכה-נזילות מוכחים ──────────
// קרן-תשואה משתפת-הכנסות-אמת (מודל pricePerShare מונוטוני — Yearn/Aave proven) +
// רשת-הפניות (מנוע-צמיחה מוכח) + ראוטר-תשואה (מקצה-הון — Yearn/Beefy proven).

model YieldPot {
  id           String   @id @default(cuid())
  asset        String   @unique // STEEM | HBD | HIVE | BLURT | TRX | USDT
  shares       Float    @default(0) // total shares outstanding (pricePerShare = assets/shares)
  assets       Float    @default(0) // underlying units incl. accrued revenue
  accruedTotal Float    @default(0) // lifetime revenue accrued (units)
  // אמת-יתרה: תמונת-מצב של יתרת-האוצר בשרשרת בטיק-הטפטוף האחרון (דלתא-מאוזנת
  // מול-הפקדות/משיכות שנרשמו בין-טיקים — אפס-ספירה-כפולה, אפס-המצאה)
  lastBalance  Float?
  lastTickAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  positions    YieldPosition[]
  ticks        YieldTick[]
}

model YieldPosition {
  id          String    @id @default(cuid())
  potId       String
  pot         YieldPot  @relation(fields: [potId], references: [id], onDelete: Cascade)
  owner       String // session label (owner:headcorner / agent:name)
  shares      Float
  lockTier    Int       @default(0) // 0=flex ×1.0 · 1=30d ×1.3 · 2=90d ×1.8 · 3=180d ×2.5 (מודל-boost מוכח)
  boost       Float     @default(1)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([potId])
  @@index([owner])
}

model YieldTick {
  id        String   @id @default(cuid())
  potId     String
  pot       YieldPot @relation(fields: [potId], references: [id], onDelete: Cascade)
  source    String // balance-delta | savings-interest | powerdown | sweep | referral
  units     Float // asset units accrued this tick
  usd       Float? // usd value at tick time (CoinGecko — honest null when unpriced)
  note      String?
  createdAt DateTime @default(now())

  @@index([potId, createdAt])
}

model ReferralCode {
  id               String   @id @default(cuid())
  slug             String   @unique
  owner            String // session label that created it
  note             String?
  clicks           Int      @default(0)
  conversions      Int      @default(0)
  bountyPendingUsd Float    @default(0)
  bountyPaidUsd    Float    @default(0)
  createdAt        DateTime @default(now())
  events           ReferralEvent[]
}

model ReferralEvent {
  id        String       @id @default(cuid())
  codeId    String
  code      ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  kind      String // click | signup | deposit | swap
  anonId    String? // anon visitor id (no PII)
  detail    String?
  bountyUsd Float        @default(0)
  createdAt DateTime     @default(now())

  @@index([codeId, createdAt])
  @@index([kind])
}
